# Flask Configuration
FLASK_SECRET_KEY=your_very_strong_secret_key_here



# Elasticsearch Configuration (choose either API key or username/password)
#ELASTICSEARCH_CLOUD_ID=
#ELASTICSEARCH_API_KEY=


# OR if using username/password instead of API key:
ELASTICSEARCH_HOST=https://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=123456
CA_CERTS=elk_901/certs/ca/ca.crt

# Application Settings
ELASTICSEARCH_INDEX=flask_users
ELASTICSEARCH_ERROR_INDEX=flask_error_logs


# OpenSearch
OPENSEARCH_HOST=https://localhost:9200
OPENSEARCH_USERNAME=isdtest
OPENSEARCH_PASSWORD=ASLgemini916





# ISD APP

# Crawler
DOMAIN=www.info.gov.hk
BASE_URL=https://sc.isd.gov.hk/TuniS/www.info.gov.hk/gia/general/202510/01c.htm
CRAWL_INDEX=dated_press_releases_sc_20260301
START_DATE=20251001
END_DATE=20260301

# Chunk
SOURCE_INDEX_NAME=dated_press_releases_sc_20260301
CHUNK_INDEX_NAME=chunked_dated_press_releases_sc_20260301

# app

# SEARCH_INDEX_NAME=chunked_dated_press_releases_sc_20260301

# LLM provider switch: vllm | ollama | auto
LLM_PROVIDER=vllm

# Active LLM endpoint/model used by chatbot_agent_api.py
LLM_API=http://localhost:8000/v1/chat/completions
LLM_MODEL=DeepSeek-R1-Distill-Qwen-32B-Int4-W4A16
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.7
