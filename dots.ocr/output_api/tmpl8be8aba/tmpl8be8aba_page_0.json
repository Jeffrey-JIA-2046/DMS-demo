[{"bbox": [116, 117, 226, 223], "category": "Picture"}, {"bbox": [240, 115, 473, 173], "category": "Page-header", "text": "維基百科"}, {"bbox": [473, 115, 539, 181], "category": "Picture"}, {"bbox": [240, 185, 466, 223], "category": "Page-header", "text": "共慶二十五週年"}, {"bbox": [116, 225, 602, 302], "category": "Section-header", "text": "# 鰂魚涌海濱花園"}, {"bbox": [116, 328, 953, 637], "category": "Text", "text": "鰂魚涌海濱花園（英語：Quarry Bay Promenade），興建時稱為海裕街臨時海濱長廊，是香港的一條海濱長廊，位於香港島鰂魚涌海裕街，耗資1,950萬港元興建，於2012年12月28日啟用，由康樂及文化事務署管理。值得一提，附近缺少寵物公園，最近要去到廉政公署後方較少人知道的民康街寵物公園，以及北角海濱花園寵物公園。"}, {"bbox": [1000, 350, 1526, 650], "category": "Picture"}, {"bbox": [1007, 655, 1200, 690], "category": "Caption", "text": "非寵物公園部份"}, {"bbox": [116, 718, 371, 777], "category": "Section-header", "text": "## 設施及建築"}, {"bbox": [135, 836, 940, 1077], "category": "List-item", "text": "- 海濱長廊及綠化區，約長500米，採用「前低後高」兩級台階設計；前面稍低一級，方便公眾親臨海旁，後面稍高一級，為草坪花園長廊，滿種樹木和灌木，可以眺望維多利亞港的景致，花園內的木棧道和花崗石地台是特別為了配合沿海環境而設。"}, {"bbox": [135, 1089, 663, 1135], "category": "List-item", "text": "- 寵物公園，面積達2,500平方米[1]"}, {"bbox": [135, 1154, 340, 1193], "category": "List-item", "text": "- 無障礙斜道"}, {"bbox": [135, 1212, 240, 1250], "category": "List-item", "text": "- 長椅"}, {"bbox": [135, 1269, 273, 1309], "category": "List-item", "text": "- 避雨亭"}, {"bbox": [135, 1322, 304, 1368], "category": "List-item", "text": "- 洗手間[2]"}, {"bbox": [135, 1387, 540, 1426], "category": "List-item", "text": "- 香港天文台鰂魚涌潮汐站"}, {"bbox": [135, 1445, 439, 1485], "category": "List-item", "text": "- 港鐵及東隧通風井"}, {"bbox": [135, 1504, 439, 1544], "category": "List-item", "text": "- 鰂魚涌煤氣調壓站"}, {"bbox": [135, 1563, 340, 1603], "category": "List-item", "text": "- 收費停車場"}, {"bbox": [1000, 773, 1526, 1073], "category": "Picture"}, {"bbox": [1007, 1078, 1171, 1113], "category": "Caption", "text": "寵物公園部份"}, {"bbox": [161, 1709, 416, 1857], "category": "Picture"}, {"bbox": [135, 1968, 292, 2008], "category": "Caption", "text": "無障礙斜道"}, {"bbox": [493, 1709, 747, 1857], "category": "Picture"}, {"bbox": [466, 1968, 750, 2051], "category": "Caption", "text": "富藝術氣息的有蓋木椅雅座"}, {"bbox": [826, 1709, 1080, 1857], "category": "Picture"}, {"bbox": [798, 1968, 927, 2008], "category": "Caption", "text": "露天木椅"}, {"bbox": [1157, 1709, 1411, 1857], "category": "Picture"}, {"bbox": [1130, 1968, 1414, 2051], "category": "Caption", "text": "連接原有的鰂魚涌公園（通過煤氣用地）"}]