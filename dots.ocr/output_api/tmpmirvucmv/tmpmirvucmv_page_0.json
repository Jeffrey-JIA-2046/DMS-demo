[{"bbox": [117, 120, 225, 222], "category": "Picture"}, {"bbox": [241, 116, 473, 172], "category": "Page-header", "text": "維基百科"}, {"bbox": [473, 116, 538, 180], "category": "Picture"}, {"bbox": [241, 186, 466, 222], "category": "Page-header", "text": "共慶二十五週年"}, {"bbox": [117, 226, 601, 301], "category": "Section-header", "text": "# 鰂魚涌海濱花園"}, {"bbox": [117, 329, 952, 636], "category": "Text", "text": "鰂魚涌海濱花園（英語：Quarry Bay Promenade），興建時稱為海裕街臨時海濱長廊，是香港的一條海濱長廊，位於香港島鰂魚涌海裕街，耗資1,950萬港元興建，於2012年12月28日啟用，由康樂及文化事務署管理。值得一提，附近缺少寵物公園，最近要去到廉政公署後方較少人知道的民康街寵物公園，以及北角海濱花園寵物公園。"}, {"bbox": [1002, 351, 1526, 649], "category": "Picture"}, {"bbox": [1007, 656, 1199, 689], "category": "Caption", "text": "非寵物公園部份"}, {"bbox": [117, 718, 371, 776], "category": "Section-header", "text": "## 設施及建築"}, {"bbox": [135, 836, 940, 1077], "category": "List-item", "text": "- 海濱長廊及綠化區，約長500米，採用「前低後高」兩級台階設計；前面稍低一級，方便公眾親臨海旁，後面稍高一級，為草坪花園長廊，滿種樹木和灌木，可以眺望維多利亞港的景致，花園內的木棧道和花崗石地台是特別為了配合沿海環境而設。"}, {"bbox": [135, 1089, 662, 1135], "category": "List-item", "text": "- 寵物公園，面積達2,500平方米[1]"}, {"bbox": [135, 1154, 339, 1192], "category": "List-item", "text": "- 無障礙斜道"}, {"bbox": [135, 1212, 239, 1249], "category": "List-item", "text": "- 長椅"}, {"bbox": [135, 1270, 272, 1309], "category": "List-item", "text": "- 避雨亭"}, {"bbox": [135, 1322, 303, 1368], "category": "List-item", "text": "- 洗手間[2]"}, {"bbox": [135, 1387, 540, 1425], "category": "List-item", "text": "- 香港天文台鰂魚涌潮汐站"}, {"bbox": [135, 1444, 438, 1483], "category": "List-item", "text": "- 港鐵及東隧通風井"}, {"bbox": [135, 1503, 438, 1542], "category": "List-item", "text": "- 鰂魚涌煤氣調壓站"}, {"bbox": [135, 1562, 339, 1601], "category": "List-item", "text": "- 收費停車場"}, {"bbox": [1002, 774, 1526, 1072], "category": "Picture"}, {"bbox": [1007, 1079, 1171, 1112], "category": "Caption", "text": "寵物公園部份"}, {"bbox": [130, 1624, 448, 1941], "category": "Picture"}, {"bbox": [135, 1969, 292, 2006], "category": "Caption", "text": "無障礙斜道"}, {"bbox": [462, 1624, 779, 1941], "category": "Picture"}, {"bbox": [466, 1969, 750, 2050], "category": "Caption", "text": "富藝術氣息的有蓋木椅雅座"}, {"bbox": [795, 1624, 1110, 1941], "category": "Picture"}, {"bbox": [799, 1969, 927, 2006], "category": "Caption", "text": "露天木椅"}, {"bbox": [1126, 1624, 1444, 1941], "category": "Picture"}, {"bbox": [1130, 1969, 1414, 2050], "category": "Caption", "text": "連接原有的鰂魚涌公園（通過煤氣用地）"}]