<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_ReviewerApprover"
                  targetNamespace="http://dms/workflows">
  <bpmn:process id="Process_ReviewerApprover" name="Document Reviewer-Approver Workflow" isExecutable="true">
    <bpmn:startEvent id="Activity_Begin" name="Begin">
      <bpmn:outgoing>Flow_Begin_Reviewer</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Activity_Reviewer" name="Reviewer Review">
      <bpmn:incoming>Flow_Begin_Reviewer</bpmn:incoming>
      <bpmn:outgoing>Flow_Reviewer_Approver</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reviewer_Uploader</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Activity_Approver" name="Approver Approval">
      <bpmn:incoming>Flow_Reviewer_Approver</bpmn:incoming>
      <bpmn:outgoing>Flow_Approver_End</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approver_Uploader</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Activity_Uploader" name="Returned to Uploader">
      <bpmn:incoming>Flow_Reviewer_Uploader</bpmn:incoming>
      <bpmn:incoming>Flow_Approver_Uploader</bpmn:incoming>
      <bpmn:outgoing>Flow_Uploader_End</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="Activity_End" name="End">
      <bpmn:incoming>Flow_Approver_End</bpmn:incoming>
      <bpmn:incoming>Flow_Uploader_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Begin_Reviewer" sourceRef="Activity_Begin" targetRef="Activity_Reviewer" name="Start" />
    <bpmn:sequenceFlow id="Flow_Reviewer_Approver" sourceRef="Activity_Reviewer" targetRef="Activity_Approver" name="Reviewer APPROVE" />
    <bpmn:sequenceFlow id="Flow_Reviewer_Uploader" sourceRef="Activity_Reviewer" targetRef="Activity_Uploader" name="Reviewer REJECT" />
    <bpmn:sequenceFlow id="Flow_Approver_End" sourceRef="Activity_Approver" targetRef="Activity_End" name="Approver APPROVE" />
    <bpmn:sequenceFlow id="Flow_Approver_Uploader" sourceRef="Activity_Approver" targetRef="Activity_Uploader" name="Approver REJECT" />
    <bpmn:sequenceFlow id="Flow_Uploader_End" sourceRef="Activity_Uploader" targetRef="Activity_End" name="Uploader ACK" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_ReviewerApprover">
    <bpmndi:BPMNPlane id="BPMNPlane_ReviewerApprover" bpmnElement="Process_ReviewerApprover">
      <bpmndi:BPMNShape id="Shape_Begin" bpmnElement="Activity_Begin">
        <dc:Bounds x="120" y="220" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Reviewer" bpmnElement="Activity_Reviewer">
        <dc:Bounds x="220" y="200" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Approver" bpmnElement="Activity_Approver">
        <dc:Bounds x="430" y="120" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Uploader" bpmnElement="Activity_Uploader">
        <dc:Bounds x="430" y="280" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End" bpmnElement="Activity_End">
        <dc:Bounds x="660" y="220" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Begin_Reviewer" bpmnElement="Flow_Begin_Reviewer">
        <di:waypoint x="156" y="238" />
        <di:waypoint x="220" y="238" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Reviewer_Approver" bpmnElement="Flow_Reviewer_Approver">
        <di:waypoint x="360" y="220" />
        <di:waypoint x="430" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Reviewer_Uploader" bpmnElement="Flow_Reviewer_Uploader">
        <di:waypoint x="360" y="260" />
        <di:waypoint x="430" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Approver_End" bpmnElement="Flow_Approver_End">
        <di:waypoint x="580" y="160" />
        <di:waypoint x="678" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Approver_Uploader" bpmnElement="Flow_Approver_Uploader">
        <di:waypoint x="505" y="200" />
        <di:waypoint x="505" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Uploader_End" bpmnElement="Flow_Uploader_End">
        <di:waypoint x="580" y="320" />
        <di:waypoint x="678" y="256" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
